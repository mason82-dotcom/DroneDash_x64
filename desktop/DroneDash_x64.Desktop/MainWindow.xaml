<Window x:Class="DroneDash_x64.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:planning="clr-namespace:DroneDash_x64.Desktop.Planning"
        xmlns:photo="clr-namespace:DroneDash_x64.Desktop.Photogrammetry"
        xmlns:pv="clr-namespace:DroneDash_x64.Desktop.PvAnalysis"
        xmlns:farming="clr-namespace:DroneDash_x64.Desktop.SmartFarming"
        Title="DroneDash_x64"
        Height="940" Width="1280"
        MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#15191F" Padding="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="RC Bridge" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0"/>
        <TextBox x:Name="EndpointBox" Grid.Column="1" Text="http://127.0.0.1:49152/" MinWidth="260"/>
        <TextBlock Grid.Column="2" Text="Token" Foreground="White" FontWeight="SemiBold" Margin="12,0,8,0"/>
        <PasswordBox x:Name="TokenBox" Grid.Column="3" Password="change-me-now" Padding="7" Margin="4"/>
        <Button x:Name="ConnectButton" Grid.Column="4" Content="Verbinden" Click="ConnectButton_Click"/>
        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
          <Ellipse x:Name="ConnectionDot" Width="12" Height="12" Fill="#B94A48" Margin="0,0,7,0"/>
          <TextBlock x:Name="ConnectionText" Text="Offline" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>
    </Border>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="FooterText" Text="Bereit"/>
      </StatusBarItem>
    </StatusBar>

    <TabControl Margin="12">
      <TabItem Header="Status">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Column="0" Header="System" Margin="6">
              <StackPanel Margin="14">
                <TextBlock Text="SDK"/>
                <TextBlock x:Name="SdkText" Style="{StaticResource ValueText}" Text="—"/>
                <TextBlock Text="Aircraft"/>
                <TextBlock x:Name="AircraftText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                <TextBlock Text="RC"/>
                <TextBlock x:Name="RcText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Energie &amp; GNSS" Margin="6">
              <StackPanel Margin="14">
                <TextBlock Text="Aircraft Akku"/>
                <TextBlock x:Name="AircraftBatteryText" Style="{StaticResource ValueText}" Text="—"/>
                <TextBlock Text="RC Akku"/>
                <TextBlock x:Name="RcBatteryText" Style="{StaticResource ValueText}" Text="—"/>
                <TextBlock Text="Satelliten"/>
                <TextBlock x:Name="SatelliteText" Style="{StaticResource ValueText}" Text="—"/>
              </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Flugstatus" Margin="6">
              <StackPanel Margin="14">
                <TextBlock Text="Modus"/>
                <TextBlock x:Name="FlightModeText" Style="{StaticResource ValueText}" Text="—"/>
                <TextBlock Text="In der Luft"/>
                <TextBlock x:Name="FlyingText" Style="{StaticResource ValueText}" Text="—"/>
                <TextBlock Text="Letztes Update"/>
                <TextBlock x:Name="TimestampText" Style="{StaticResource ValueText}" Text="—"/>
              </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Header="Position" Margin="6">
              <Grid Margin="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Latitude"/>
                  <TextBlock x:Name="LatitudeText" Style="{StaticResource ValueText}" Text="—"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Longitude"/>
                  <TextBlock x:Name="LongitudeText" Style="{StaticResource ValueText}" Text="—"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Höhe"/>
                  <TextBlock x:Name="AltitudeText" Style="{StaticResource ValueText}" Text="—"/>
                </StackPanel>
              </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Grid.Column="2" Header="Attitude" Margin="6">
              <Grid Margin="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Pitch"/>
                  <TextBlock x:Name="PitchText" Style="{StaticResource ValueText}" Text="—"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Roll"/>
                  <TextBlock x:Name="RollText" Style="{StaticResource ValueText}" Text="—"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Yaw"/>
                  <TextBlock x:Name="YawText" Style="{StaticResource ValueText}" Text="—"/>
                </StackPanel>
              </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Grid.Column="0" Header="Navigation" Margin="6">
              <StackPanel Margin="14">
                <TextBlock Text="GPS-Signal"/>
                <TextBlock x:Name="GpsSignalText" Style="{StaticResource ValueText}" Text="—"/>
                <TextBlock Text="Home Point"/>
                <TextBlock x:Name="HomePointText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                <TextBlock Text="Kompass"/>
                <TextBlock x:Name="CompassText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="2" Grid.Column="1" Header="Geschwindigkeit &amp; Wind" Margin="6">
              <StackPanel Margin="14">
                <TextBlock Text="Ground Speed"/>
                <TextBlock x:Name="GroundSpeedText" Style="{StaticResource ValueText}" Text="—"/>
                <TextBlock Text="Vertikal"/>
                <TextBlock x:Name="VerticalSpeedText" Style="{StaticResource ValueText}" Text="—"/>
                <TextBlock Text="N / E / D"/>
                <TextBlock x:Name="VelocityNedText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                <TextBlock Text="Wind"/>
                <TextBlock x:Name="WindText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="2" Grid.Column="2" Header="Aircraft Details" Margin="6">
              <StackPanel Margin="14">
                <TextBlock Text="Akku elektrisch"/>
                <TextBlock x:Name="BatteryElectricalText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                <TextBlock Text="Akku Kapazität"/>
                <TextBlock x:Name="BatteryCapacityText" Style="{StaticResource ValueText}" Text="—"/>
                <TextBlock Text="Motoren / Takeoff"/>
                <TextBlock x:Name="MotorTakeoffText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="3" Grid.ColumnSpan="3" Header="RTK" Margin="6">
              <Grid Margin="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Status"/>
                  <TextBlock x:Name="RtkStatusText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                  <TextBlock Text="Quelle"/>
                  <TextBlock x:Name="RtkSourceText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="Mobile Station"/>
                  <TextBlock x:Name="RtkMobileText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                  <TextBlock Text="Standardabweichung Längs / Quer / Höhe"/>
                  <TextBlock x:Name="RtkAccuracyText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Base Station"/>
                  <TextBlock x:Name="RtkBaseText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                  <TextBlock Text="Heading"/>
                  <TextBlock x:Name="RtkHeadingText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                  <TextBlock Text="RTK Satelliten"/>
                  <TextBlock x:Name="RtkSatellitesText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                  <TextBlock Text="RTK Fehler"/>
                  <TextBlock x:Name="RtkErrorText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </GroupBox>

            <GroupBox Grid.Row="4" Grid.ColumnSpan="2" Header="Kamera &amp; Speicher" Margin="6">
              <Grid Margin="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Kamera"/>
                  <TextBlock x:Name="CameraIdentityText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                  <TextBlock Text="Modus / Aktivität"/>
                  <TextBlock x:Name="CameraActivityText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="SD-Karte"/>
                  <TextBlock x:Name="SdStorageText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                  <TextBlock Text="Verbleibend"/>
                  <TextBlock x:Name="SdRemainingText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Interner Speicher"/>
                  <TextBlock x:Name="InternalStorageText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                  <TextBlock Text="Verbleibend"/>
                  <TextBlock x:Name="InternalRemainingText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </GroupBox>

            <GroupBox Grid.Row="4" Grid.Column="2" Header="Gimbal" Margin="6">
              <StackPanel Margin="14">
                <TextBlock Text="Modus"/>
                <TextBlock x:Name="GimbalModeText" Style="{StaticResource ValueText}" Text="—"/>
                <TextBlock Text="Pitch / Roll / Yaw"/>
                <TextBlock x:Name="GimbalAttitudeText" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Geräte">
        <TabControl Margin="8">
          <TabItem Header="Aircraft">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <UniformGrid Columns="2" Margin="14">
                <GroupBox Header="Identität" Margin="6">
                  <TextBlock x:Name="AircraftIdentityDetailText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </GroupBox>
                <GroupBox Header="Flugzustand" Margin="6">
                  <TextBlock x:Name="AircraftFlightDetailText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </GroupBox>
                <GroupBox Header="Position &amp; Home Point" Margin="6">
                  <TextBlock x:Name="AircraftPositionDetailText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </GroupBox>
                <GroupBox Header="Bewegung &amp; Wind" Margin="6">
                  <TextBlock x:Name="AircraftMotionDetailText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </GroupBox>
                <GroupBox Header="Attitude" Margin="6">
                  <TextBlock x:Name="AircraftAttitudeDetailText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </GroupBox>
                <GroupBox Header="GNSS &amp; Kompass" Margin="6">
                  <TextBlock x:Name="AircraftNavDetailText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </GroupBox>
              </UniformGrid>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="RC">
            <UniformGrid Columns="2" Margin="18">
              <GroupBox Header="Remote Controller" Margin="6">
                <TextBlock x:Name="RcIdentityDetailText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </GroupBox>
              <GroupBox Header="RC Energie" Margin="6">
                <TextBlock x:Name="RcBatteryDetailText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </GroupBox>
              <GroupBox Header="Bridge / SDK" Margin="6">
                <TextBlock x:Name="RcBridgeDetailText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </GroupBox>
              <GroupBox Header="Verbindungszustand" Margin="6">
                <TextBlock x:Name="RcConnectionDetailText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </GroupBox>
            </UniformGrid>
          </TabItem>

          <TabItem Header="Energie">
            <UniformGrid Columns="2" Margin="18">
              <GroupBox Header="Aircraft Akku" Margin="6">
                <TextBlock x:Name="EnergyAircraftDetailText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </GroupBox>
              <GroupBox Header="Kapazität" Margin="6">
                <TextBlock x:Name="EnergyCapacityDetailText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </GroupBox>
              <GroupBox Header="Remote Controller" Margin="6">
                <TextBlock x:Name="EnergyRcDetailText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </GroupBox>
              <GroupBox Header="Bewertung" Margin="6">
                <TextBlock x:Name="EnergyHealthDetailText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </GroupBox>
            </UniformGrid>
          </TabItem>

          <TabItem Header="RTK">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <UniformGrid Columns="2" Margin="14">
                <GroupBox Header="Status" Margin="6">
                  <TextBlock x:Name="RtkDetailStatusText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </GroupBox>
                <GroupBox Header="Referenz" Margin="6">
                  <TextBlock x:Name="RtkDetailSourceText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </GroupBox>
                <GroupBox Header="Mobile Station" Margin="6">
                  <TextBlock x:Name="RtkDetailMobileText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </GroupBox>
                <GroupBox Header="Base Station" Margin="6">
                  <TextBlock x:Name="RtkDetailBaseText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </GroupBox>
                <GroupBox Header="Genauigkeit &amp; Heading" Margin="6">
                  <TextBlock x:Name="RtkDetailAccuracyText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </GroupBox>
                <GroupBox Header="Satelliten / Fehler" Margin="6">
                  <TextBlock x:Name="RtkDetailSatellitesText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
                </GroupBox>
              </UniformGrid>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Kamera / Gimbal">
            <UniformGrid Columns="2" Margin="18">
              <GroupBox Header="Kamera" Margin="6">
                <TextBlock x:Name="CameraDetailIdentityText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </GroupBox>
              <GroupBox Header="Aktivität" Margin="6">
                <TextBlock x:Name="CameraDetailActivityText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </GroupBox>
              <GroupBox Header="SD / interner Speicher" Margin="6">
                <TextBlock x:Name="CameraDetailStorageText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </GroupBox>
              <GroupBox Header="Gimbal" Margin="6">
                <TextBlock x:Name="GimbalDetailText" Margin="14" Style="{StaticResource ValueText}" Text="—" TextWrapping="Wrap"/>
              </GroupBox>
            </UniformGrid>
          </TabItem>
        </TabControl>
      </TabItem>

      <TabItem Header="Diagnose">
        <DockPanel Margin="16">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Content="Log leeren" Click="ClearEvents_Click"/>
            <Button Content="CSV exportieren" Click="ExportEvents_Click"/>
            <TextBlock x:Name="EventCountText" Margin="14,0,0,0" VerticalAlignment="Center" Text="0 Ereignisse"/>
          </StackPanel>

          <Border DockPanel.Dock="Top" Margin="4,8" Padding="10" Background="#FFF8D8">
            <TextBlock TextWrapping="Wrap"
                       Text="Das Eventlog protokolliert Zustandswechsel und Warnungen lokal in der Windows-App. Die 1-Hz-Live-Telemetrie wird nicht vollständig mitgeschrieben."/>
          </Border>

          <DataGrid x:Name="EventGrid"
                    Margin="4"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Zeit" Binding="{Binding TimeText}" Width="165"/>
              <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90"/>
              <DataGridTextColumn Header="Quelle" Binding="{Binding Source}" Width="140"/>
              <DataGridTextColumn Header="Ereignis" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Konfiguration">
        <Grid Margin="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Max. Flughöhe (m)" Margin="4,4,18,4"/>
          <TextBox x:Name="HeightLimitBox" Grid.Row="0" Grid.Column="1"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="RTH-Höhe (m)" Margin="4,4,18,4"/>
          <TextBox x:Name="GoHomeHeightBox" Grid.Row="1" Grid.Column="1"/>

          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <Button Content="Lesen" Click="ReadConfig_Click"/>
            <Button Content="Speichern" Click="SaveConfig_Click"/>
          </StackPanel>

          <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Margin="24,4" Padding="16"
                  BorderBrush="#D0A000" BorderThickness="1" CornerRadius="4">
            <TextBlock TextWrapping="Wrap">
              Änderungen werden direkt über DJI KeyManager an den verbundenen Flugcontroller geschrieben.
              Die zulässigen Bereiche werden von Firmware, Region und Fluggerät bestimmt; DJI kann Werte außerhalb
              des gültigen Bereichs ablehnen. Vor Feldbetrieb die Werte in DJI Pilot 2 gegenprüfen.
            </TextBlock>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Flugplanung">
        <planning:FlightPlanningView/>
      </TabItem>

      <TabItem Header="Photogrammetrie">
        <photo:PhotogrammetryWorkspaceView/>
      </TabItem>

      <TabItem Header="PV-Analyse">
        <pv:PvAnalysisView/>
      </TabItem>

      <TabItem Header="Smart Farming">
        <farming:SmartFarmingView/>
      </TabItem>

      <TabItem Header="Medien">
        <DockPanel Margin="16">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Content="Liste aktualisieren" Click="RefreshMedia_Click"/>
            <Button Content="Vorschau + Metadaten" Click="PreviewMedia_Click"/>
            <Button Content="Lokales Bild / DNG öffnen" Click="OpenLocalImage_Click"/>
            <Button Content="M3T Testbild" Click="OpenM3tFixture_Click"/>
            <Button Content="Auswahl herunterladen" Click="DownloadMedia_Click"/>
            <ProgressBar x:Name="DownloadProgress" Width="190" Height="18" Minimum="0" Maximum="100"
                         Margin="14,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="MediaInfoText" VerticalAlignment="Center" Text="Noch nicht geladen."/>
          </StackPanel>

          <Border DockPanel.Dock="Bottom" Padding="8" Margin="0,10,0,0" Background="#FFF8D8">
            <TextBlock TextWrapping="Wrap">
              Hinweis: Für die Aircraft-Vorschau wird das Original temporär geladen. Während DJI MediaManager aktiv ist,
              sind Aufnahme und normale Bildübertragung vorübergehend nicht verfügbar. Lokale Dateien können ohne RC geöffnet werden.
            </TextBlock>
          </Border>

          <Grid Margin="4,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="0.9*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="MediaGrid"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      MouseDoubleClick="MediaGrid_MouseDoubleClick">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="70"/>
                <DataGridTextColumn Header="Dateiname" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="90"/>
                <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" Width="100"/>
                <DataGridTextColumn Header="Datum" Binding="{Binding Date}" Width="155"/>
              </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="2.2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.4*"/>
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Margin="4" Background="#101318" BorderBrush="#30363D" BorderThickness="1">
                <Grid>
                  <ScrollViewer x:Name="MediaPreviewScroll"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                    <Image x:Name="MediaPreviewImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           MouseMove="MediaPreviewImage_MouseMove"
                           MouseLeave="MediaPreviewImage_MouseLeave"/>
                  </ScrollViewer>
                  <TextBlock x:Name="MediaPreviewPlaceholder"
                             Text="Bild auswählen und „Vorschau + Metadaten“ klicken"
                             Foreground="#AAB2BD"
                             FontSize="16"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             Margin="24"/>
                  <Border x:Name="ThermalCursorPanel"
                          Visibility="Collapsed"
                          IsHitTestVisible="False"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Bottom"
                          Margin="12"
                          Padding="8,5"
                          Background="#CC111820"
                          CornerRadius="4">
                    <TextBlock x:Name="ThermalCursorText"
                               Foreground="White"
                               FontWeight="SemiBold"
                               Text="x=0 · y=0 · 0,00 °C"/>
                  </Border>
                </Grid>
              </Border>

              <Grid Grid.Row="1" Margin="4,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock x:Name="MediaPreviewTitle" FontWeight="SemiBold" Text="Keine Vorschau"/>
                  <TextBlock x:Name="MediaPreviewSummary" Text="—" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Content="Einpassen" Click="FitPreview_Click"/>
                  <Button Content="1:1" Click="ActualSizePreview_Click"/>
                </StackPanel>
              </Grid>

              <Border Grid.Row="2"
                      Margin="4,4,4,2"
                      Padding="10"
                      BorderBrush="#4A6572"
                      BorderThickness="1"
                      CornerRadius="4"
                      Background="#EEF5F7">
                <StackPanel>
                  <TextBlock Text="Photogrammetrie / DJI XMP" FontWeight="SemiBold"/>
                  <TextBlock x:Name="PhotogrammetrySummaryText"
                             Margin="0,3,0,0"
                             Text="Keine Datei geladen."
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <Border Grid.Row="3"
                      Margin="4,2"
                      Padding="10"
                      BorderBrush="#8A5A00"
                      BorderThickness="1"
                      CornerRadius="4"
                      Background="#FFF4D6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="DJI Thermal SDK v1.8" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ThermalSdkStatusText"
                               Margin="0,3,0,0"
                               Text="Thermal SDK wird geprüft …"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="ThermalSummaryText"
                               Margin="0,3,0,0"
                               Text="Noch keine Thermal-Analyse."
                               TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="ThermalPaletteBox" Width="130" SelectedIndex="2" Margin="4">
                      <ComboBoxItem Content="White Hot" Tag="WhiteHot"/>
                      <ComboBoxItem Content="Fulgurite" Tag="Fulgurite"/>
                      <ComboBoxItem Content="Iron Red" Tag="IronRed"/>
                      <ComboBoxItem Content="Hot Iron" Tag="HotIron"/>
                      <ComboBoxItem Content="Medical" Tag="Medical"/>
                      <ComboBoxItem Content="Arctic" Tag="Arctic"/>
                      <ComboBoxItem Content="Rainbow 1" Tag="Rainbow1"/>
                      <ComboBoxItem Content="Rainbow 2" Tag="Rainbow2"/>
                      <ComboBoxItem Content="Tint" Tag="Tint"/>
                      <ComboBoxItem Content="Black Hot" Tag="BlackHot"/>
                    </ComboBox>
                    <Button x:Name="ThermalAnalyzeButton"
                            Content="Thermal analysieren"
                            Click="ThermalAnalyze_Click"/>
                    <Button Content="Original"
                            Click="RestoreOriginalPreview_Click"/>
                  </StackPanel>
                </Grid>
              </Border>

              <DataGrid x:Name="MetadataGrid"
                        Grid.Row="4"
                        Margin="4"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Gruppe" Binding="{Binding Group}" Width="110"/>
                  <DataGridTextColumn Header="Feld" Binding="{Binding Name}" Width="190"/>
                  <DataGridTextColumn Header="Wert" Binding="{Binding Value}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Grid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
