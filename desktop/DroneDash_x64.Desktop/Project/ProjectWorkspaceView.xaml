<UserControl x:Class="DroneDash_x64.Desktop.Project.ProjectWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="DroneDash Projekt"
                 FontSize="20"
                 FontWeight="SemiBold"/>
      <TextBlock Margin="0,3,0,10"
                 TextWrapping="Wrap"
                 Text="Gemeinsamer Projektcontainer für Flugplanung, Photogrammetrie, PV, Smart Farming, ODM und weitere Ergebnisse. Die .ddproj-Datei referenziert Artefakte und kopiert keine Rohdaten."/>

      <WrapPanel>
        <Button Content="Neu"
                Click="NewProject_Click"/>
        <Button Content="Öffnen"
                Click="OpenProject_Click"/>
        <Button x:Name="SaveProjectButton"
                Content="Speichern"
                Click="SaveProject_Click"
                IsEnabled="False"/>
        <Button x:Name="SaveProjectAsButton"
                Content="Speichern unter"
                Click="SaveProjectAs_Click"
                IsEnabled="False"/>
        <Button x:Name="AddFilesButton"
                Content="Dateien hinzufügen"
                Click="AddFiles_Click"
                IsEnabled="False"/>
        <Button x:Name="AddFolderButton"
                Content="Datenordner hinzufügen"
                Click="AddFolder_Click"
                IsEnabled="False"/>
        <Button x:Name="DiscoverButton"
                Content="Projektordner scannen"
                Click="Discover_Click"
                IsEnabled="False"/>
        <Button x:Name="RemoveArtifactButton"
                Content="Auswahl entfernen"
                Click="RemoveArtifact_Click"
                IsEnabled="False"/>
        <Button x:Name="VerifyButton"
                Content="Integrität prüfen"
                Click="Verify_Click"
                IsEnabled="False"/>
      </WrapPanel>

      <Grid Margin="4,10,4,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Projektdatei"
                   FontWeight="SemiBold"/>
        <TextBlock x:Name="ProjectPathText"
                   Grid.Row="0"
                   Grid.Column="1"
                   Grid.ColumnSpan="3"
                   Text="Noch kein Projekt geöffnet."
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Name"
                   VerticalAlignment="Center"/>
        <TextBox x:Name="ProjectNameBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 IsEnabled="False"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="2"
                   Text="Projekt-ID"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="ProjectIdText"
                   Grid.Row="1"
                   Grid.Column="3"
                   Text="—"
                   VerticalAlignment="Center"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Beschreibung"
                   VerticalAlignment="Top"/>
        <TextBox x:Name="ProjectDescriptionBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 Grid.ColumnSpan="3"
                 Height="54"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 IsEnabled="False"/>
      </Grid>

      <Border Margin="4,0,4,10"
              Padding="10"
              Background="#F4F7F9"
              BorderBrush="#607D8B"
              BorderThickness="1"
              CornerRadius="4">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Projekt-Pipeline"
                         FontWeight="SemiBold"
                         FontSize="15"/>
              <TextBlock x:Name="PipelineStateText"
                         Margin="0,3,0,0"
                         Text="Kein aktiver Pipeline-Job."
                         TextWrapping="Wrap"/>
              <TextBlock x:Name="PipelineSourceText"
                         Margin="0,2,0,0"
                         Text="Datensatz: —"
                         TextWrapping="Wrap"/>
              <TextBlock x:Name="PipelineProbeText"
                         Margin="0,2,0,0"
                         Text="Erkennung: —"
                         TextWrapping="Wrap"/>
            </StackPanel>
            <WrapPanel Grid.Column="1"
                       VerticalAlignment="Top"
                       Margin="12,0,0,0">
              <Button x:Name="IngestDatasetButton"
                      Content="Datensatz-Ingest"
                      Click="IngestDataset_Click"
                      IsEnabled="False"/>
              <Button x:Name="ContinuePipelineButton"
                      Content="Job fortsetzen"
                      Click="ContinuePipeline_Click"
                      IsEnabled="False"/>
              <Button x:Name="RefreshPipelineButton"
                      Content="Gates aktualisieren"
                      Click="RefreshPipeline_Click"
                      IsEnabled="False"/>
            </WrapPanel>
          </Grid>

          <UniformGrid Columns="5"
                       Margin="0,8,0,0">
            <GroupBox Header="Flugplan" Margin="2">
              <StackPanel Margin="6">
                <TextBlock x:Name="PipelinePlanGateStateText"
                           Text="OFFEN"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="PipelinePlanGateDetailText"
                           Text="—"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="Datensatz" Margin="2">
              <StackPanel Margin="6">
                <TextBlock x:Name="PipelineDatasetGateStateText"
                           Text="OFFEN"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="PipelineDatasetGateDetailText"
                           Text="—"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="RTK" Margin="2">
              <StackPanel Margin="6">
                <TextBlock x:Name="PipelineRtkGateStateText"
                           Text="OFFEN"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="PipelineRtkGateDetailText"
                           Text="—"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="Processing" Margin="2">
              <StackPanel Margin="6">
                <TextBlock x:Name="PipelineProcessingGateStateText"
                           Text="OFFEN"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="PipelineProcessingGateDetailText"
                           Text="—"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="Ergebnis" Margin="2">
              <StackPanel Margin="6">
                <TextBlock x:Name="PipelineResultGateStateText"
                           Text="OFFEN"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="PipelineResultGateDetailText"
                           Text="—"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>
          </UniformGrid>

          <Border Margin="2,8,2,0"
                  Padding="8"
                  Background="#FFFFFF"
                  BorderBrush="#B0BEC5"
                  BorderThickness="1"
                  CornerRadius="3">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0"
                         Grid.Column="0"
                         Text="Aktiver Worker"
                         FontWeight="SemiBold"/>
              <TextBlock x:Name="ProcessingWorkerText"
                         Grid.Row="0"
                         Grid.Column="1"
                         Text="—"
                         TextWrapping="Wrap"/>
              <TextBlock x:Name="ProcessingJobStatusText"
                         Grid.Row="0"
                         Grid.Column="2"
                         Text="—"
                         HorizontalAlignment="Right"
                         FontWeight="SemiBold"/>

              <TextBlock Grid.Row="1"
                         Grid.Column="0"
                         Text="Schritt"
                         Margin="0,4,0,0"/>
              <TextBlock x:Name="ProcessingJobMessageText"
                         Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Margin="0,4,0,0"
                         Text="Kein Processing-Job."
                         TextWrapping="Wrap"/>

              <TextBlock Grid.Row="2"
                         Grid.Column="0"
                         Text="Fortschritt"
                         Margin="0,4,0,0"/>
              <ProgressBar x:Name="ProcessingJobProgress"
                           Grid.Row="2"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Height="14"
                           Margin="0,7,0,0"
                           Minimum="0"
                           Maximum="100"/>

              <TextBlock Grid.Row="3"
                         Grid.Column="0"
                         Text="Log"
                         Margin="0,4,0,0"/>
              <TextBlock x:Name="ProcessingJobLogText"
                         Grid.Row="3"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Margin="0,4,0,0"
                         Text="—"
                         TextWrapping="Wrap"/>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <TextBlock Margin="4,2,4,3"
                 Text="Workflow · Stufe anklicken, um direkt in das passende Modul zu wechseln"
                 FontWeight="SemiBold"/>

      <UniformGrid Columns="4"
                   Margin="4,0,4,8">
        <Button x:Name="PlanningStageButton"
                Tag="Planning"
                Click="WorkflowStage_Click"
                Margin="3"
                Padding="0">
          <Border Padding="10">
            <StackPanel>
              <TextBlock Text="1 · Planung" FontWeight="SemiBold"/>
              <TextBlock x:Name="PlanningStageStateText"
                         Margin="0,4,0,0"
                         Text="Offen"
                         FontWeight="SemiBold"/>
              <TextBlock x:Name="PlanningStageDetailText"
                         Text="Noch kein Planungsartefakt."
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Button>
        <Button x:Name="DatasetStageButton"
                Tag="Dataset"
                Click="WorkflowStage_Click"
                Margin="3"
                Padding="0">
          <Border Padding="10">
            <StackPanel>
              <TextBlock Text="2 · Datensatz" FontWeight="SemiBold"/>
              <TextBlock x:Name="DatasetStageStateText"
                         Margin="0,4,0,0"
                         Text="Offen"
                         FontWeight="SemiBold"/>
              <TextBlock x:Name="DatasetStageDetailText"
                         Text="Noch kein Datensatzartefakt."
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Button>
        <Button x:Name="ProcessingStageButton"
                Tag="Processing"
                Click="WorkflowStage_Click"
                Margin="3"
                Padding="0">
          <Border Padding="10">
            <StackPanel>
              <TextBlock Text="3 · Processing" FontWeight="SemiBold"/>
              <TextBlock x:Name="ProcessingStageStateText"
                         Margin="0,4,0,0"
                         Text="Offen"
                         FontWeight="SemiBold"/>
              <TextBlock x:Name="ProcessingStageDetailText"
                         Text="Noch kein Processing-Artefakt."
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Button>
        <Button x:Name="AnalysisStageButton"
                Tag="Analysis"
                Click="WorkflowStage_Click"
                Margin="3"
                Padding="0">
          <Border Padding="10">
            <StackPanel>
              <TextBlock Text="4 · Ergebnis / QA" FontWeight="SemiBold"/>
              <TextBlock x:Name="AnalysisStageStateText"
                         Margin="0,4,0,0"
                         Text="Offen"
                         FontWeight="SemiBold"/>
              <TextBlock x:Name="AnalysisStageDetailText"
                         Text="Noch kein Analyseartefakt."
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Button>
      </UniformGrid>

      <TextBlock Margin="4,2,4,3"
                 Text="Projekt-Dashboard"
                 FontWeight="SemiBold"/>
      <UniformGrid Columns="4"
                   Margin="4,0,4,8">
        <GroupBox Header="RTK-QA" Margin="3">
          <StackPanel Margin="8">
            <TextBlock x:Name="RtkQaStateText"
                       Text="Offen"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="RtkQaDetailText"
                       Text="Noch keine RTK-QA."
                       TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Datensatz-QA" Margin="3">
          <StackPanel Margin="8">
            <TextBlock x:Name="DatasetQaStateText"
                       Text="Offen"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="DatasetQaDetailText"
                       Text="Noch keine Datensatz-QA."
                       TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Processing" Margin="3">
          <StackPanel Margin="8">
            <TextBlock x:Name="ProcessingQaStateText"
                       Text="Offen"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="ProcessingQaDetailText"
                       Text="Noch keine Processing-QA."
                       TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Ergebnis-QA" Margin="3">
          <StackPanel Margin="8">
            <TextBlock x:Name="ResultsQaStateText"
                       Text="Offen"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="ResultsQaDetailText"
                       Text="Noch keine Ergebnis-QA."
                       TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>
      </UniformGrid>

      <Border Margin="4,0,4,8"
              Padding="10"
              Background="#EEF5F7"
              BorderBrush="#4A6572"
              BorderThickness="1"
              CornerRadius="4">
        <TextBlock x:Name="ProjectSummaryText"
                   Text="Kein Projekt geladen."
                   TextWrapping="Wrap"/>
      </Border>

      <ProgressBar x:Name="ProjectProgress"
                   Height="4"
                   Margin="4,0,4,8"
                   Minimum="0"
                   Maximum="100"/>
    </StackPanel>

    <DataGrid x:Name="ArtifactGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              SelectionMode="Extended"
              SelectionChanged="ArtifactGrid_SelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Typ"
                            Binding="{Binding KindText}"
                            Width="175"/>
        <DataGridTextColumn Header="Bezeichnung"
                            Binding="{Binding Label}"
                            Width="220"/>
        <DataGridTextColumn Header="Pfad"
                            Binding="{Binding StoredPath}"
                            Width="*"/>
        <DataGridTextColumn Header="Modus"
                            Binding="{Binding PathModeText}"
                            Width="70"/>
        <DataGridTextColumn Header="Größe"
                            Binding="{Binding SizeText}"
                            Width="90"/>
        <DataGridTextColumn Header="Integrität"
                            Binding="{Binding IntegrityText}"
                            Width="90"/>
        <DataGridTextColumn Header="Details"
                            Binding="{Binding Detail}"
                            Width="300"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
