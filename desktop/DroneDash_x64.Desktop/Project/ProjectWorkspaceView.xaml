<UserControl x:Class="DroneDash_x64.Desktop.Project.ProjectWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="DroneDash Projekt"
                 FontSize="20"
                 FontWeight="SemiBold"/>
      <TextBlock Margin="0,3,0,10"
                 TextWrapping="Wrap"
                 Text="Gemeinsamer Projektcontainer für Flugplanung, Photogrammetrie, PV, Smart Farming, ODM und weitere Ergebnisse. Die .ddproj-Datei referenziert Artefakte und kopiert keine Rohdaten."/>

      <WrapPanel>
        <Button Content="Neu"
                Click="NewProject_Click"/>
        <Button Content="Öffnen"
                Click="OpenProject_Click"/>
        <Button x:Name="SaveProjectButton"
                Content="Speichern"
                Click="SaveProject_Click"
                IsEnabled="False"/>
        <Button x:Name="SaveProjectAsButton"
                Content="Speichern unter"
                Click="SaveProjectAs_Click"
                IsEnabled="False"/>
        <Button x:Name="AddFilesButton"
                Content="Dateien hinzufügen"
                Click="AddFiles_Click"
                IsEnabled="False"/>
        <Button x:Name="AddFolderButton"
                Content="Datenordner hinzufügen"
                Click="AddFolder_Click"
                IsEnabled="False"/>
        <Button x:Name="DiscoverButton"
                Content="Projektordner scannen"
                Click="Discover_Click"
                IsEnabled="False"/>
        <Button x:Name="RemoveArtifactButton"
                Content="Auswahl entfernen"
                Click="RemoveArtifact_Click"
                IsEnabled="False"/>
        <Button x:Name="VerifyButton"
                Content="Integrität prüfen"
                Click="Verify_Click"
                IsEnabled="False"/>
      </WrapPanel>

      <Grid Margin="4,10,4,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Projektdatei"
                   FontWeight="SemiBold"/>
        <TextBlock x:Name="ProjectPathText"
                   Grid.Row="0"
                   Grid.Column="1"
                   Grid.ColumnSpan="3"
                   Text="Noch kein Projekt geöffnet."
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Name"
                   VerticalAlignment="Center"/>
        <TextBox x:Name="ProjectNameBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 IsEnabled="False"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="2"
                   Text="Projekt-ID"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="ProjectIdText"
                   Grid.Row="1"
                   Grid.Column="3"
                   Text="—"
                   VerticalAlignment="Center"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Beschreibung"
                   VerticalAlignment="Top"/>
        <TextBox x:Name="ProjectDescriptionBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 Grid.ColumnSpan="3"
                 Height="54"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 IsEnabled="False"/>
      </Grid>

      <UniformGrid Columns="4"
                   Margin="4,0,4,8">
        <GroupBox Header="1 · Planung" Margin="3">
          <StackPanel Margin="8">
            <TextBlock x:Name="PlanningStageStateText"
                       Text="Offen"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="PlanningStageDetailText"
                       Text="Noch kein Planungsartefakt."
                       TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="2 · Datensatz" Margin="3">
          <StackPanel Margin="8">
            <TextBlock x:Name="DatasetStageStateText"
                       Text="Offen"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="DatasetStageDetailText"
                       Text="Noch kein Datensatzartefakt."
                       TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="3 · Processing" Margin="3">
          <StackPanel Margin="8">
            <TextBlock x:Name="ProcessingStageStateText"
                       Text="Offen"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="ProcessingStageDetailText"
                       Text="Noch kein Processing-Artefakt."
                       TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="4 · Analyse / Feldprodukt" Margin="3">
          <StackPanel Margin="8">
            <TextBlock x:Name="AnalysisStageStateText"
                       Text="Offen"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="AnalysisStageDetailText"
                       Text="Noch kein Analyseartefakt."
                       TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>
      </UniformGrid>

      <Border Margin="4,0,4,8"
              Padding="10"
              Background="#EEF5F7"
              BorderBrush="#4A6572"
              BorderThickness="1"
              CornerRadius="4">
        <TextBlock x:Name="ProjectSummaryText"
                   Text="Kein Projekt geladen."
                   TextWrapping="Wrap"/>
      </Border>

      <ProgressBar x:Name="ProjectProgress"
                   Height="4"
                   Margin="4,0,4,8"
                   Minimum="0"
                   Maximum="100"/>
    </StackPanel>

    <DataGrid x:Name="ArtifactGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              SelectionMode="Extended"
              SelectionChanged="ArtifactGrid_SelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Typ"
                            Binding="{Binding KindText}"
                            Width="175"/>
        <DataGridTextColumn Header="Bezeichnung"
                            Binding="{Binding Label}"
                            Width="220"/>
        <DataGridTextColumn Header="Pfad"
                            Binding="{Binding StoredPath}"
                            Width="*"/>
        <DataGridTextColumn Header="Modus"
                            Binding="{Binding PathModeText}"
                            Width="70"/>
        <DataGridTextColumn Header="Größe"
                            Binding="{Binding SizeText}"
                            Width="90"/>
        <DataGridTextColumn Header="Integrität"
                            Binding="{Binding IntegrityText}"
                            Width="90"/>
        <DataGridTextColumn Header="Details"
                            Binding="{Binding Detail}"
                            Width="300"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
