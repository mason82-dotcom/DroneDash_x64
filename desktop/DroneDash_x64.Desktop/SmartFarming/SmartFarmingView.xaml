<UserControl x:Class="DroneDash_x64.Desktop.SmartFarming.SmartFarmingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Smart Farming · DJI Mavic 3M"
                 FontSize="20"
                 FontWeight="SemiBold"/>
      <TextBlock Margin="0,3,0,10"
                 TextWrapping="Wrap"
                 Text="M3M-Datensatzprüfung und Vegetationsindex-Quicklooks für Green, Red, Red Edge und NIR. Die Einzelaufnahme-Quicklooks sind nicht orthorektifiziert oder vollständig bandregistriert und ersetzen keine finale Feldkarte."/>

      <WrapPanel>
        <Button Content="M3M-Bildordner wählen" Click="SelectFolder_Click"/>
        <Button x:Name="ScanButton" Content="Datensatz prüfen" Click="Scan_Click"/>
        <Button x:Name="ExportDatasetButton" Content="Datensatz-QA exportieren"
                Click="ExportDataset_Click" IsEnabled="False"/>
        <Button x:Name="ExportQuicklookButton" Content="Quicklook exportieren"
                Click="ExportQuicklook_Click" IsEnabled="False"/>
      </WrapPanel>

      <Grid Margin="4,10,4,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Bildordner" FontWeight="SemiBold"/>
        <TextBlock x:Name="FolderText" Grid.Row="0" Grid.Column="1"
                   Text="Noch nicht gewählt." TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Text="Status" FontWeight="SemiBold"/>
        <TextBlock x:Name="StatusText" Grid.Row="1" Grid.Column="1"
                   Text="Bereit." TextWrapping="Wrap"/>
      </Grid>

      <ProgressBar x:Name="Progress" Height="4" Margin="4,0,4,8"
                   IsIndeterminate="False"/>

      <Border Margin="4,0,4,10" Padding="10" Background="#EEF5F7"
              BorderBrush="#4A6572" BorderThickness="1" CornerRadius="4">
        <TextBlock x:Name="SummaryText"
                   Text="Noch kein M3M-Datensatz geprüft."
                   TextWrapping="Wrap"/>
      </Border>
    </StackPanel>

    <TabControl>
      <TabItem Header="Aufnahmen">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DataGrid x:Name="CaptureGrid" AutoGenerateColumns="False"
                    IsReadOnly="True" CanUserAddRows="False"
                    SelectionMode="Single"
                    SelectionChanged="CaptureGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Aufnahme" Binding="{Binding CaptureKey}" Width="210"/>
              <DataGridCheckBoxColumn Header="Komplett" Binding="{Binding IsComplete}" Width="70"/>
              <DataGridCheckBoxColumn Header="Quicklook" Binding="{Binding IsQuicklookReady}" Width="75"/>
              <DataGridTextColumn Header="GPS" Binding="{Binding GpsText}" Width="180"/>
              <DataGridTextColumn Header="RTK" Binding="{Binding RtkText}" Width="100"/>
              <DataGridTextColumn Header="QA" Binding="{Binding StatusText}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Row="1" Margin="0,8,0,0" Padding="10" Background="#FFF8D8">
            <TextBlock TextWrapping="Wrap"
                       Text="M3M-Namensschema: DJI_…_D.JPG plus DJI_…_MS_G.TIF, _MS_R.TIF, _MS_RE.TIF und _MS_NIR.TIF. Die Originaldateien werden nicht verändert."/>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Vegetationsindex-Quicklook">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="390"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Margin="0,0,8,0" Background="#101318"
                  BorderBrush="#30363D" BorderThickness="1">
            <Grid>
              <Image x:Name="IndexImage" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock x:Name="IndexPlaceholder"
                         Text="Eine vollständige M3M-Aufnahme auswählen und NDVI, NDRE oder GNDVI berechnen."
                         Foreground="#C7CDD5" FontSize="15" TextAlignment="Center"
                         TextWrapping="Wrap" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Margin="28"/>
            </Grid>
          </Border>

          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8,0,0,0">
              <TextBlock Text="Index berechnen" FontWeight="SemiBold" FontSize="16"/>
              <WrapPanel Margin="0,6,0,8">
                <Button Content="NDVI" Tag="Ndvi" Click="ComputeIndex_Click"/>
                <Button Content="NDRE" Tag="Ndre" Click="ComputeIndex_Click"/>
                <Button Content="GNDVI" Tag="Gndvi" Click="ComputeIndex_Click"/>
              </WrapPanel>
              <TextBlock x:Name="IndexStatsText"
                         Text="Noch kein Index berechnet." TextWrapping="Wrap"/>
              <Border Margin="0,10,0,10" Padding="10" Background="#FFF4D6"
                      BorderBrush="#8A5A00" BorderThickness="1" CornerRadius="4">
                <TextBlock TextWrapping="Wrap"
                           Text="Qualitätshinweis: Die M3M-TIFFs sind DN-Daten. DroneDash kompensiert im Quicklook BlackLevel, SensorGain, ExposureTime, SensorGainAdjustment und Irradiance. Vignettierungs-/Distortionskorrektur, Subpixel-Co-Registrierung, Orthorektifizierung und Reflektanzpanel-Kalibrierung sind in dieser Stufe noch nicht vollständig enthalten."/>
              </Border>
              <TextBlock Text="Indexformeln" FontWeight="SemiBold"/>
              <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="NDVI = (NIR − Red) / (NIR + Red)&#x0a;NDRE = (NIR − Red Edge) / (NIR + Red Edge)&#x0a;GNDVI = (NIR − Green) / (NIR + Green)"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Lokales Processing">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <TextBlock Text="GDAL · Orfeo ToolBox · OpenCV"
                       FontSize="16"
                       FontWeight="SemiBold"/>
            <TextBlock Margin="0,3,0,8"
                       TextWrapping="Wrap"
                       Text="DroneDash verwendet die Tools optional als lokale Worker. M3M-Originale bleiben read-only; alle Zwischenprodukte landen im gewählten Workspace."/>
            <WrapPanel>
              <Button Content="Toolchain prüfen"
                      Click="CheckTools_Click"/>
              <Button x:Name="CreateLocalPlanButton"
                      Content="Processing-Workspace erzeugen"
                      Click="CreateLocalPlan_Click"
                      IsEnabled="False"/>
              <Button x:Name="RunLocalPlanButton"
                      Content="Pipeline ausführen"
                      Click="RunLocalPlan_Click"
                      IsEnabled="False"/>
              <Button x:Name="CancelLocalPlanButton"
                      Content="Abbrechen"
                      Click="CancelLocalPlan_Click"
                      IsEnabled="False"/>
            </WrapPanel>
          </StackPanel>

          <DataGrid x:Name="ToolGrid"
                    Grid.Row="1"
                    Margin="0,8,0,8"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Tool" Binding="{Binding Name}" Width="150"/>
              <DataGridTextColumn Header="Status" Binding="{Binding StateText}" Width="70"/>
              <DataGridTextColumn Header="Version" Binding="{Binding VersionText}" Width="90"/>
              <DataGridTextColumn Header="Executable" Binding="{Binding ExecutableText}" Width="300"/>
              <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>

          <Border Grid.Row="2"
                  Padding="10"
                  Margin="0,0,0,8"
                  Background="#FFF8D8">
            <TextBlock x:Name="ToolchainSummaryText"
                       TextWrapping="Wrap"
                       Text="Noch nicht geprüft. Overrides: DRONEDASH_GDAL_BIN, DRONEDASH_OTB_BIN und DRONEDASH_PYTHON."/>
          </Border>

          <StackPanel Grid.Row="3">
            <ProgressBar x:Name="LocalProcessingProgress"
                         Minimum="0"
                         Maximum="100"
                         Height="6"/>
            <TextBlock x:Name="LocalProcessingStatusText"
                       Margin="0,4,0,8"
                       Text="Keine lokale Pipeline aktiv."
                       TextWrapping="Wrap"/>
          </StackPanel>

          <TextBox x:Name="PlanPreviewText"
                   Grid.Row="4"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas"
                   Text="Noch kein lokaler Processing-Plan erzeugt."/>

          <TextBox x:Name="LocalRunLogText"
                   Grid.Row="5"
                   Margin="0,8,0,0"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas"
                   Text="Live-Log erscheint hier."/>
        </Grid>
      </TabItem>

      <TabItem Header="ODM-Orthomosaik">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     Text="NodeODM · georeferenziertes M3M-Orthomosaik"
                     FontSize="16"
                     FontWeight="SemiBold"/>

          <Grid Grid.Row="1" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Endpoint" VerticalAlignment="Center"/>
            <TextBox x:Name="NodeOdmEndpointBox"
                     Grid.Column="1"
                     Text="http://127.0.0.1:3000/"/>
            <TextBlock Grid.Column="2"
                       Text="Kalibrierung"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"/>
            <ComboBox x:Name="NodeOdmCalibrationCombo"
                      Grid.Column="3"
                      SelectedIndex="0">
              <ComboBoxItem Content="camera+sun (experimentell)" Tag="camera+sun"/>
              <ComboBoxItem Content="camera" Tag="camera"/>
            </ComboBox>
          </Grid>

          <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition Width="250"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Token" VerticalAlignment="Center"/>
            <PasswordBox x:Name="NodeOdmTokenBox" Grid.Column="1"/>
            <WrapPanel Grid.Column="2" Margin="10,0,0,0">
              <Button Content="NodeODM prüfen" Click="CheckNodeOdm_Click"/>
              <Button x:Name="StartNodeOdmTaskButton"
                      Content="M3M-Task starten"
                      Click="StartNodeOdmTask_Click"
                      IsEnabled="False"/>
              <Button x:Name="RefreshNodeOdmTaskButton"
                      Content="Status aktualisieren"
                      Click="RefreshNodeOdmTask_Click"
                      IsEnabled="False"/>
              <Button x:Name="CancelNodeOdmTaskButton"
                      Content="Task abbrechen"
                      Click="CancelNodeOdmTask_Click"
                      IsEnabled="False"/>
              <Button x:Name="DownloadNodeOdmButton"
                      Content="Ergebnis ZIP"
                      Click="DownloadNodeOdm_Click"
                      IsEnabled="False"/>
            </WrapPanel>
          </Grid>

          <StackPanel Grid.Row="3">
            <Border Padding="10"
                    Background="#EEF5F7"
                    BorderBrush="#4A6572"
                    BorderThickness="1"
                    CornerRadius="4">
              <TextBlock x:Name="NodeOdmStatusText"
                         Text="NodeODM noch nicht geprüft."
                         TextWrapping="Wrap"/>
            </Border>
            <ProgressBar x:Name="NodeOdmProgress"
                         Minimum="0"
                         Maximum="100"
                         Height="6"
                         Margin="0,8,0,0"/>
          </StackPanel>

          <TextBox x:Name="NodeOdmLogText"
                   Grid.Row="4"
                   Margin="0,8,0,0"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas"
                   Text="NodeODM-Upload- und Task-Log erscheint hier."/>
        </Grid>
      </TabItem>

      <TabItem Header="ODM-Feldprodukte">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <TextBlock Text="NodeODM-Ergebnis → georeferenzierte Feldprodukte"
                       FontSize="16"
                       FontWeight="SemiBold"/>
            <TextBlock Margin="0,3,0,8"
                       TextWrapping="Wrap"
                       Text="Importiert NodeODM all.zip sicher, findet odm_orthophoto.tif, liest die Bandzuordnung per GDAL und erzeugt NDVI, NDRE, GNDVI sowie eine 5-Klassen-NDVI-Scouting-Zonenkarte."/>
            <WrapPanel>
              <Button Content="NodeODM ZIP importieren"
                      Click="ImportNodeOdmZip_Click"/>
              <Button x:Name="GenerateOdmFieldProductsButton"
                      Content="Feldprodukte berechnen"
                      Click="GenerateOdmFieldProducts_Click"
                      IsEnabled="False"/>
              <Button x:Name="CancelOdmFieldProductsButton"
                      Content="Abbrechen"
                      Click="CancelOdmFieldProducts_Click"
                      IsEnabled="False"/>
            </WrapPanel>
          </StackPanel>

          <Border Grid.Row="1"
                  Margin="0,8,0,8"
                  Padding="10"
                  Background="#EEF5F7"
                  BorderBrush="#4A6572"
                  BorderThickness="1"
                  CornerRadius="4">
            <TextBlock x:Name="OdmImportedStatusText"
                       Text="Noch kein NodeODM ZIP importiert."
                       TextWrapping="Wrap"/>
          </Border>

          <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Z1/Z2 Grenze" VerticalAlignment="Center"/>
            <TextBox x:Name="ZoneThreshold1Box" Grid.Column="1" Text="0.20"/>
            <TextBlock Grid.Column="2" Text="Z2/Z3 Grenze" VerticalAlignment="Center"/>
            <TextBox x:Name="ZoneThreshold2Box" Grid.Column="3" Text="0.40"/>
            <TextBlock Grid.Column="4" Text="Z3/Z4 Grenze" VerticalAlignment="Center"/>
            <TextBox x:Name="ZoneThreshold3Box" Grid.Column="5" Text="0.60"/>
            <TextBlock Grid.Column="6" Text="Z4/Z5 Grenze" VerticalAlignment="Center"/>
            <TextBox x:Name="ZoneThreshold4Box" Grid.Column="7" Text="0.80"/>
            <TextBlock Grid.Column="8"
                       Margin="10,0,0,0"
                       TextWrapping="Wrap"
                       Text="Die Zonen sind Scouting-Klassen, keine automatische Dünge-/Bewässerungs-/Pflanzenschutzempfehlung."/>
          </Grid>

          <StackPanel Grid.Row="3">
            <ProgressBar x:Name="OdmFieldProductProgress"
                         Minimum="0"
                         Maximum="100"
                         Height="6"/>
            <TextBlock x:Name="OdmFieldProductStatusText"
                       Margin="0,4,0,8"
                       Text="Keine Feldproduktberechnung aktiv."
                       TextWrapping="Wrap"/>
          </StackPanel>

          <TextBox x:Name="OdmFieldProductLogText"
                   Grid.Row="4"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas"
                   Text="Feldprodukt-Log erscheint hier."/>
        </Grid>
      </TabItem>

      <TabItem Header="Agrar-Workflows">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <UniformGrid Columns="2" Margin="10">
            <GroupBox Header="Bestandsvitalität / Stress" Margin="6">
              <TextBlock Margin="12" TextWrapping="Wrap"
                         Text="NDVI/NDRE/GNDVI als Scouting-Layer für räumliche Unterschiede im Bestand. Auffällige Zonen sind Prüfhinweise; Ursachen wie Wasser, Nährstoffe, Krankheit oder Schädlinge müssen agronomisch verifiziert werden."/>
            </GroupBox>
            <GroupBox Header="Variable Rate / Zonen" Margin="6">
              <TextBlock Margin="12" TextWrapping="Wrap"
                         Text="Vorbereitung von Managementzonen für standortspezifische Düngung, Pflanzenschutz oder Bewässerung. Maschinenfertige Prescription-Maps werden erst aus orthorektifizierten, kalibrierten Feldkarten erzeugt."/>
            </GroupBox>
            <GroupBox Header="Aufgang / Bestandesgleichmäßigkeit" Margin="6">
              <TextBlock Margin="12" TextWrapping="Wrap"
                         Text="RGB + Multispektral für Pflanzenzählung, Fehlstellen, Aufgangskarten und Reihenhomogenität. Eine spätere Segmentierungsstufe kann Pflanzen-/Reihenobjekte automatisiert ableiten."/>
            </GroupBox>
            <GroupBox Header="Unkraut-Scouting" Margin="6">
              <TextBlock Margin="12" TextWrapping="Wrap"
                         Text="Spektrale und RGB-Layer können Hotspots für gezielte Feldbegehung markieren. Eine sichere Crop-vs-Weed-Klassifikation erfordert kultur- und trainingsspezifische Modelle."/>
            </GroupBox>
            <GroupBox Header="Wasser / Drainage / Bodenvariabilität" Margin="6">
              <TextBlock Margin="12" TextWrapping="Wrap"
                         Text="Vegetationsmuster zusammen mit DSM/DTM und wiederholten Befliegungen unterstützen das Auffinden von Vernässung, Trockenstress, Drainage- und Bodenvariabilitätszonen."/>
            </GroupBox>
            <GroupBox Header="Zeitreihen / Monitoring" Margin="6">
              <TextBlock Margin="12" TextWrapping="Wrap"
                         Text="Wiederholbare RTK-Missionen erlauben den Vergleich von Feldern über Entwicklungsstadien hinweg. Für belastbare Zeitreihen sind konsistente Aufnahmebedingungen und radiometrische Kalibrierung entscheidend."/>
            </GroupBox>
          </UniformGrid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
