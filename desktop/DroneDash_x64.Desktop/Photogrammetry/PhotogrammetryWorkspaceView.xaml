<UserControl x:Class="DroneDash_x64.Desktop.Photogrammetry.PhotogrammetryWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Photogrammetrie-Projektworkflow"
                 FontSize="20"
                 FontWeight="SemiBold"/>
      <TextBlock Margin="0,3,0,10"
                 TextWrapping="Wrap"
                 Text="DJI-Bildordner read-only analysieren, optional mit einem .ddplan-Flugplan verknüpfen, RTK/XMP/Kalibrierung prüfen und ein Processing-Manifest für Orthomosaik, DSM/DTM, 3D oder M3M-Multispektralverarbeitung erzeugen."/>

      <WrapPanel>
        <Button Content="Bildordner wählen" Click="SelectImageFolder_Click"/>
        <Button Content="Flugplan verknüpfen" Click="SelectFlightPlan_Click"/>
        <Button x:Name="AnalyzeButton"
                Content="Datensatz analysieren"
                Click="Analyze_Click"/>
        <Button x:Name="ExportManifestButton"
                Content="Processing-Manifest exportieren"
                Click="ExportManifest_Click"
                IsEnabled="False"/>
      </WrapPanel>

      <Grid Margin="4,10,4,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Bildordner" FontWeight="SemiBold"/>
        <TextBlock x:Name="ImageFolderText"
                   Grid.Row="0"
                   Grid.Column="1"
                   Text="Noch nicht gewählt."
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1" Text="Flugplan" FontWeight="SemiBold"/>
        <TextBlock x:Name="FlightPlanText"
                   Grid.Row="1"
                   Grid.Column="1"
                   Text="Optional · nicht verknüpft."
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="2" Text="Status" FontWeight="SemiBold"/>
        <TextBlock x:Name="DatasetStatusText"
                   Grid.Row="2"
                   Grid.Column="1"
                   Text="Bereit."
                   TextWrapping="Wrap"/>
      </Grid>

      <ProgressBar x:Name="DatasetProgress"
                   Height="4"
                   Margin="4,0,4,8"
                   IsIndeterminate="False"/>

      <Border Margin="4,0,4,10"
              Padding="10"
              Background="#EEF5F7"
              BorderBrush="#4A6572"
              BorderThickness="1"
              CornerRadius="4">
        <TextBlock x:Name="DatasetSummaryText"
                   Text="Noch kein Datensatz analysiert."
                   TextWrapping="Wrap"/>
      </Border>

      <Expander x:Name="NodeOdmExpander"
                Header="DSM / DTM / Punktwolke mit NodeODM berechnen"
                Margin="4,0,4,10">
        <StackPanel Margin="10">
          <TextBlock TextWrapping="Wrap" Opacity="0.8"
                     Text="Sendet die RGB-Bilder des analysierten Datensatzes an einen NodeODM-Server. Ergebnis: Oberflächenmodell (DSM), Geländemodell (DTM), Orthomosaik und georeferenzierte Punktwolke. Thermal-, Zoom- und Multispektralbilder werden automatisch ausgeschlossen."/>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Endpunkt" VerticalAlignment="Center"/>
            <TextBox x:Name="OdmEndpointBox" Grid.Row="0" Grid.Column="1" Margin="0,2"/>
            <TextBlock Grid.Row="1" Text="Token" VerticalAlignment="Center"/>
            <PasswordBox x:Name="OdmTokenBox" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
            <TextBlock Grid.Row="2" Text="Qualität" VerticalAlignment="Center"/>
            <ComboBox x:Name="OdmPresetBox" Grid.Row="2" Grid.Column="1" Margin="0,2" SelectedIndex="1">
              <ComboBoxItem Content="Schnell · DSM 10 cm/px, Punktwolke niedrig" Tag="Fast"/>
              <ComboBoxItem Content="Standard · DSM 5 cm/px, Punktwolke mittel" Tag="Standard"/>
              <ComboBoxItem Content="Hoch · DSM 2 cm/px, Punktwolke hoch (lange Laufzeit)" Tag="High"/>
            </ComboBox>
          </Grid>
          <WrapPanel Margin="0,6,0,0">
            <Button Content="Server prüfen" Click="CheckOdmServer_Click"/>
            <Button x:Name="StartOdmButton" Content="Task starten" Click="StartOdmTask_Click" IsEnabled="False"/>
            <Button x:Name="CancelOdmButton" Content="Abbrechen" Click="CancelOdmTask_Click" IsEnabled="False"/>
            <Button x:Name="ImportOdmButton" Content="Ergebnis laden &amp; importieren" Click="ImportOdmResult_Click" IsEnabled="False"/>
            <Button Content="Vorhandenes all.zip importieren" Click="ImportExistingOdmZip_Click"/>
          </WrapPanel>
          <WrapPanel Margin="0,4,0,0">
            <Button x:Name="ShowDsmButton" Content="DSM auf Karte" Click="ShowDsm_Click" IsEnabled="False"/>
            <Button x:Name="ShowDtmButton" Content="DTM auf Karte" Click="ShowDtm_Click" IsEnabled="False"/>
            <Button x:Name="ChmButton" Content="Bestandshöhe (DSM − DTM)" Click="CanopyHeight_Click" IsEnabled="False"/>
            <Button Content="Höhenmodell (GeoTIFF) öffnen …" Click="OpenElevationModel_Click"/>
            <Button x:Name="ShowPointCloudButton" Content="Punktwolke 3D" Click="ShowPointCloud_Click" IsEnabled="False"/>
            <Button Content="Punktwolke (LAS/LAZ) öffnen …" Click="OpenPointCloud_Click"/>
          </WrapPanel>
          <ProgressBar x:Name="OdmProgress" Height="4" Margin="0,8,0,4"/>
          <TextBlock x:Name="OdmStatusText" Text="Noch kein Server geprüft." TextWrapping="Wrap"/>
          <TextBlock x:Name="OdmProductsText" Margin="0,4,0,0" TextWrapping="Wrap"/>
          <TextBox x:Name="OdmLogText" Height="110" Margin="0,6,0,0" IsReadOnly="True"
                   FontFamily="Consolas" FontSize="11"
                   VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
        </StackPanel>
      </Expander>
    </StackPanel>

    <DataGrid x:Name="DatasetGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              SelectionMode="Extended">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Datei"
                            Binding="{Binding FileName}"
                            Width="220"/>
        <DataGridTextColumn Header="Quelle"
                            Binding="{Binding ImageSource}"
                            Width="100"/>
        <DataGridTextColumn Header="GPS"
                            Binding="{Binding GpsText}"
                            Width="190"/>
        <DataGridTextColumn Header="RTK"
                            Binding="{Binding RtkText}"
                            Width="210"/>
        <DataGridTextColumn Header="Route"
                            Binding="{Binding RouteText}"
                            Width="220"/>
        <DataGridTextColumn Header="Abstand"
                            Binding="{Binding DistanceText}"
                            Width="85"/>
        <DataGridTextColumn Header="QA"
                            Binding="{Binding IssuesText}"
                            Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
