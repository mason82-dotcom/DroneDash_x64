<UserControl x:Class="DroneDash_x64.Desktop.Diagnostics.RuntimeDiagnosticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top"
            Padding="14"
            Margin="0,0,0,10"
            BorderThickness="1"
            BorderBrush="#303740"
            CornerRadius="5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="Windows x64 Runtime-Diagnose"
                     FontSize="20"
                     FontWeight="SemiBold"/>
          <TextBlock x:Name="PlatformText"
                     Margin="0,4,0,0"
                     Text="Noch nicht geprüft."
                     TextWrapping="Wrap"/>
          <TextBlock x:Name="SummaryText"
                     Margin="0,4,0,0"
                     FontWeight="SemiBold"
                     Text="—"/>
          <TextBlock x:Name="LastProbeText"
                     Margin="0,3,0,0"
                     Opacity="0.65"
                     FontSize="11"
                     Text="—"/>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
          <Button x:Name="RefreshButton"
                  Content="Neu prüfen"
                  Click="Refresh_Click"
                  MinWidth="110"/>
          <ProgressBar x:Name="ProbeProgress"
                       Margin="0,8,0,0"
                       Height="5"
                       IsIndeterminate="True"
                       Visibility="Collapsed"/>
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock DockPanel.Dock="Bottom"
               Margin="2,8,2,0"
               Opacity="0.65"
               TextWrapping="Wrap"
               Text="Fehlende optionale Komponenten blockieren DroneDash nicht. Fehler in Windows-/Prozessarchitektur, .NET oder WebView2 betreffen dagegen den Desktop selbst. CUDA, GDAL, OTB, Python, DJI Thermal SDK und NodeODM werden nur für die jeweiligen Verarbeitungswege benötigt."/>

    <DataGrid x:Name="DiagnosticsGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Status"
                            Binding="{Binding StateText}"
                            Width="125"/>
        <DataGridTextColumn Header="Bereich"
                            Binding="{Binding Category}"
                            Width="145"/>
        <DataGridTextColumn Header="Komponente"
                            Binding="{Binding Name}"
                            Width="175"/>
        <DataGridTextColumn Header="Version"
                            Binding="{Binding VersionText}"
                            Width="170"/>
        <DataGridTextColumn Header="Pfad / Endpoint"
                            Binding="{Binding PathText}"
                            Width="2*"/>
        <DataGridTextColumn Header="Details"
                            Binding="{Binding Detail}"
                            Width="3*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
